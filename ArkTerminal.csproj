<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
        <ApplicationManifest>app.manifest</ApplicationManifest>
    </PropertyGroup>

    <ItemGroup>
        <Compile Remove="ArkTerminal.Core/**;ArkTerminal.Terminal/**" />
        <EmbeddedResource Remove="ArkTerminal.Core/**;ArkTerminal.Terminal/**" />
        <None Remove="ArkTerminal.Core/**;ArkTerminal.Terminal/**" />
        <Page Remove="ArkTerminal.Core/**;ArkTerminal.Terminal/**" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="ArkTerminal.Core\ArkTerminal.Core.csproj" />
        <ProjectReference Include="ArkTerminal.Terminal\ArkTerminal.Terminal.csproj" />
        <PackageReference Include="Vortice.Direct2D1" Version="3.8.3" />
        <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
        <PackageReference Include="Vortice.Direct3D9" Version="3.8.3" />
    </ItemGroup>

</Project>
