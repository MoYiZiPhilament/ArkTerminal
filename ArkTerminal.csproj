<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    </PropertyGroup>

    <ItemGroup>
        <Compile Remove="ArkTerminal.Core/**;ArkTerminal.Terminal/**;ArkTerminal.Mcp/**;Packaging/**" />
        <EmbeddedResource Remove="ArkTerminal.Core/**;ArkTerminal.Terminal/**;ArkTerminal.Mcp/**;Packaging/**" />
        <None Remove="ArkTerminal.Core/**;ArkTerminal.Terminal/**;ArkTerminal.Mcp/**;Packaging/**" />
        <Page Remove="ArkTerminal.Core/**;ArkTerminal.Terminal/**;ArkTerminal.Mcp/**;Packaging/**" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="ArkTerminal.Core\ArkTerminal.Core.csproj" />
        <ProjectReference Include="ArkTerminal.Terminal\ArkTerminal.Terminal.csproj" />
        <ProjectReference Include="ArkTerminal.Mcp\ArkTerminal.Mcp.csproj" ReferenceOutputAssembly="false" Private="false" />
        <PackageReference Include="Vortice.Direct2D1" Version="3.8.3" />
        <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
        <PackageReference Include="Vortice.Direct3D9" Version="3.8.3" />
    </ItemGroup>

    <Target Name="CopyMcpBridge" AfterTargets="Build">
        <ItemGroup><McpBridgeFiles Include="ArkTerminal.Mcp\bin\$(Configuration)\net10.0-windows\$(RuntimeIdentifier)\*" /></ItemGroup>
        <Copy SourceFiles="@(McpBridgeFiles)" DestinationFolder="$(OutDir)Mcp" SkipUnchangedFiles="true" />
    </Target>
    <Target Name="PublishMcpBridge" AfterTargets="ComputeFilesToPublish">
        <MSBuild Projects="ArkTerminal.Mcp\ArkTerminal.Mcp.csproj" Targets="Publish"
                 BuildInParallel="false"
                 Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained);PublishDir=$(MSBuildProjectDirectory)\obj\McpPublish\$(Configuration)\$(RuntimeIdentifier)\" />
        <ItemGroup>
            <McpPublishFiles Include="obj\McpPublish\$(Configuration)\$(RuntimeIdentifier)\**\*" />
            <ResolvedFileToPublish Include="@(McpPublishFiles)">
                <RelativePath>Mcp\%(McpPublishFiles.RecursiveDir)%(McpPublishFiles.Filename)%(McpPublishFiles.Extension)</RelativePath>
                <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            </ResolvedFileToPublish>
        </ItemGroup>
    </Target>

</Project>
