<Application x:Class="ArkTerminal.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="Theme.AccentBrush" Color="#4688F1"/>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ArkTerminal;component/Visuals/Themes/Shared.xaml"/>
                <ResourceDictionary Source="/ArkTerminal;component/Visuals/Themes/Light.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
