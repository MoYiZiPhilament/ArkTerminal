<Window x:Class="ArkTerminal.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:rendering="clr-namespace:ArkTerminal.Rendering"
        xmlns:controls="clr-namespace:ArkTerminal.Controls"
        xmlns:visuals="clr-namespace:ArkTerminal.Visuals"
        Title="ArkTerminal · 新建" Width="1180" Height="800" MinWidth="720" MinHeight="520"
        WindowStyle="None" ResizeMode="CanResize" UseLayoutRounding="True"
        Background="{DynamicResource Theme.WindowBackground}"
        Closing="Window_Closing" SourceInitialized="Window_SourceInitialized" PreviewKeyDown="Window_PreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <!-- Legacy region fallback; Windows 11 switches to the DWM outer silhouette after attachment. -->
        <shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="24" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <controls:RoundedBorder x:Name="WindowFrame" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource Theme.BorderBrush}">
    <Grid x:Name="WindowLayer">
        <Grid x:Name="BackgroundLayer" IsHitTestVisible="False">
            <Image x:Name="BackgroundImage" Visibility="Collapsed" Stretch="UniformToFill"/>
            <visuals:AuroraBackgroundControl x:Name="AuroraView"/>
            <Rectangle x:Name="BackgroundOverlay" Fill="{DynamicResource Theme.WindowBackground}" Opacity="0.25"/>
            <Rectangle x:Name="ReadabilityOverlay" Fill="{DynamicResource Theme.WindowBackground}" Opacity="0"/>
        </Grid>
        <Grid x:Name="RootGrid">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="LeftTabColumn" Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="0"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

            <Grid x:Name="TitleBar" Grid.Row="0" Grid.ColumnSpan="3" Background="{DynamicResource Theme.SurfaceBackground}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button x:Name="AppMenuButton" Content="&#xE700;" Style="{StaticResource IconButton}" Click="AppMenu_Click" ToolTip="应用菜单" AutomationProperties.Name="应用菜单" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button.ContextMenu>
                        <ContextMenu Placement="Bottom" HorizontalOffset="0" VerticalOffset="8">
                            <MenuItem Header="新建会话" InputGestureText="Ctrl+Shift+T" Click="NewPage_Click"/>
                            <MenuItem Header="命令面板" Click="ShowCommandPalette_Click"/>
                            <MenuItem Header="上下文预览 / Agent 交接" InputGestureText="Ctrl+Shift+F9" Click="OpenContext_Click"/>
                            <MenuItem Header="保存错误快照…" Click="OpenSnapshot_Click"/>
                            <MenuItem Header="审阅建议 / 确认执行命令" Click="OpenCommandReview_Click"/>
                            <MenuItem Header="只读 MCP：授权 / 撤销 / 配置" Click="McpAccess_Click"/>
                            <Separator/>
                            <MenuItem Header="设置" Click="Settings_Click"/>
                            <MenuItem Header="专注模式" Click="FocusMode_Click"/>
                            <MenuItem Header="性能模式" Click="PerformanceMode_Click"/>
                            <Separator/>
                            <MenuItem Header="关闭窗口" InputGestureText="Alt+F4" Click="CloseWindow_Click" Foreground="{DynamicResource Theme.ErrorBorder}"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <TextBlock x:Name="CaptionTitle" Grid.Column="1" Text="ArkTerminal" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Theme.SecondaryText}" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20,0"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <StackPanel x:Name="NavigationPanel" Orientation="Horizontal" Margin="0,0,8,0">
                        <Button x:Name="CommandPaletteButton" Content="&#xE721;" Style="{StaticResource IconButton}" Click="ShowCommandPalette_Click" ToolTip="命令面板" AutomationProperties.Name="命令面板"/>
                        <Button Content="&#xE713;" Style="{StaticResource IconButton}" Click="Settings_Click" ToolTip="设置" AutomationProperties.Name="设置"/>
                        <Button Content="&#xE740;" Style="{StaticResource IconButton}" Click="FocusMode_Click" ToolTip="专注模式" AutomationProperties.Name="专注模式"/>
                        <Button x:Name="PerformanceModeButton" Content="&#xE945;" Style="{StaticResource IconButton}" Click="PerformanceMode_Click" ToolTip="性能模式" AutomationProperties.Name="性能模式"/>
                    </StackPanel>
                    <Button Content="&#xE921;" Style="{StaticResource CaptionButton}" Click="MinimizeWindow_Click" ToolTip="最小化" AutomationProperties.Name="最小化"/>
                    <Button x:Name="MaximizeWindowButton" Content="&#xE922;" Style="{StaticResource CaptionButton}" Click="MaximizeWindow_Click" ToolTip="最大化" AutomationProperties.Name="最大化"/>
                    <Button Content="&#xE8BB;" Tag="CloseWindow" Style="{StaticResource CaptionButton}" Click="CloseWindow_Click" ToolTip="关闭" AutomationProperties.Name="关闭"/>
                </StackPanel>
            </Grid>

            <Grid x:Name="TabHost" Grid.Row="0" Grid.ColumnSpan="3" Margin="52,5,310,5">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border x:Name="TabRailBackground" Grid.RowSpan="2" Grid.ColumnSpan="4" CornerRadius="12" Background="Transparent" IsHitTestVisible="False"/>
                <StackPanel x:Name="TabNavigationButtons" shell:WindowChrome.IsHitTestVisibleInChrome="True" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="&#xE76B;" Style="{StaticResource IconButton}" Width="24" Click="PreviousTab_Click" ToolTip="上一个标签" AutomationProperties.Name="上一个标签"/>
                    <Button Content="&#xE76C;" Style="{StaticResource IconButton}" Width="24" Click="NextTab_Click" ToolTip="下一个标签" AutomationProperties.Name="下一个标签"/>
                </StackPanel>
                <ScrollViewer x:Name="TabScrollViewer" Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                    <controls:TerminalTabStrip x:Name="TabStrip" OrientationEx="Horizontal">
                        <controls:TerminalTabStrip.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></controls:TerminalTabStrip.ItemsPanel>
                        <controls:TerminalTabStrip.ItemTemplate><DataTemplate>
                            <Border x:Name="TabBorder" shell:WindowChrome.IsHitTestVisibleInChrome="True" Padding="10,0" MinHeight="36" Margin="2,1" BorderBrush="Transparent" BorderThickness="1" CornerRadius="9"
                                    Background="Transparent" MouseLeftButtonDown="Tab_MouseLeftButtonDown" ToolTip="{Binding ToolTipText}">
                                <Border.ContextMenu><ContextMenu>
                                    <MenuItem Header="重命名 / 清除固定名称" Click="RenameTab_Click"/>
                                    <MenuItem Header="重复标签" Click="DuplicateTab_Click"/>
                                    <MenuItem Header="重启会话" Click="RestartTab_Click"/>
                                    <Separator/><MenuItem Header="关闭标签" Click="CloseTab_Click"/>
                                </ContextMenu></Border.ContextMenu>
                                <DockPanel>
                                    <Button x:Name="TabClose" DockPanel.Dock="Right" Content="&#xE8BB;" Style="{StaticResource IconButton}" FontSize="9" Width="22" Height="26" MinHeight="26" Margin="4,0,0,0" Click="CloseTab_Click" ToolTip="关闭标签" AutomationProperties.Name="关闭标签"/>
                                    <TextBlock x:Name="TabIcon" DockPanel.Dock="Left" Text="{Binding Icon}" Width="22" Margin="0,0,6,0" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                                    <TextBlock x:Name="TabLabel" Text="{Binding Title}" Foreground="{DynamicResource Theme.SecondaryText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="TabBorder" Property="IsMouseOver" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource Theme.HoverBackground}"/></Trigger>
                                <DataTrigger Binding="{Binding IsActive}" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource Theme.ActiveTabBackground}"/><Setter TargetName="TabLabel" Property="Foreground" Value="{DynamicResource Theme.PrimaryText}"/></DataTrigger>
                                <DataTrigger Binding="{Binding IsNewPage}" Value="True"><Setter TargetName="TabClose" Property="Visibility" Value="Collapsed"/></DataTrigger>
                                <DataTrigger Binding="{Binding Icon}" Value=""><Setter TargetName="TabIcon" Property="Text" Value="›_"/><Setter TargetName="TabIcon" Property="Foreground" Value="{DynamicResource Theme.AccentBrush}"/></DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate></controls:TerminalTabStrip.ItemTemplate>
                    </controls:TerminalTabStrip>
                </ScrollViewer>
                <Button x:Name="NewTabButton" shell:WindowChrome.IsHitTestVisibleInChrome="True" Grid.Column="2" Content="&#xE710;" Style="{StaticResource IconButton}" Click="NewPage_Click" ToolTip="新建会话" AutomationProperties.Name="新建会话"/>
                <TextBlock x:Name="TabCountText" Grid.Column="3" Visibility="Collapsed" VerticalAlignment="Center" Margin="4,0"/>
            </Grid>
            <GridSplitter x:Name="LeftTabSplitter" Grid.Row="2" Grid.Column="1" Width="5" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="Transparent" Cursor="SizeWE"/>

            <Grid x:Name="WorkbenchContent" Grid.Row="2" Grid.Column="2" Margin="10,8,10,0">
                <ScrollViewer x:Name="NewPage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="24,24,24,16" MaxWidth="880">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                            <Border Width="48" Height="48" CornerRadius="14" Background="{DynamicResource Theme.ActiveTabBackground}" Margin="0,0,16,0">
                                <TextBlock Text="&gt;_" FontFamily="Cascadia Mono, Consolas" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource Theme.AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel><TextBlock Text="新建会话" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="选择 Shell、Profile 或 Agent，开始你的工作。" Foreground="{DynamicResource Theme.SecondaryText}" Margin="0,4,0,0"/></StackPanel>
                        </StackPanel>
                        <Border x:Name="ErrorPanel" Padding="18" CornerRadius="12" Margin="0,0,0,16" Background="{DynamicResource Theme.ErrorBackground}" BorderBrush="{DynamicResource Theme.ErrorBorder}" BorderThickness="1">
                            <StackPanel><TextBlock Text="需要处理的问题" FontWeight="SemiBold"/><TextBlock x:Name="ErrorText" TextWrapping="Wrap" Margin="0,8"/><Button Content="备份后恢复无效文档默认值" Click="ResetButton_Click" HorizontalAlignment="Left"/></StackPanel>
                        </Border>
                        <Border x:Name="RecoveryPanel" Padding="18" CornerRadius="12" Margin="0,0,0,16" Background="{DynamicResource Theme.RecoveryBackground}" BorderBrush="{DynamicResource Theme.RecoveryBorder}" BorderThickness="1">
                            <StackPanel><TextBlock Text="恢复上次工作" FontWeight="SemiBold"/><TextBlock Text="可恢复草稿和标签布局。会话等待你确认启动。" Margin="0,8"/><WrapPanel><Button Content="恢复" Click="RecoverButton_Click"/><Button Content="丢弃恢复数据" Click="DiscardRecoveryButton_Click"/></WrapPanel></StackPanel>
                        </Border>
                        <Border Padding="20" CornerRadius="12" Margin="0,0,0,20" Background="{DynamicResource Theme.CardBackground}" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="工作目录" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,4"/>
                                <TextBlock Text="为新会话选择起点，或沿用 Profile 的目录。" Foreground="{DynamicResource Theme.SecondaryText}" Margin="0,0,0,14"/>
                                <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox x:Name="DirectoryInput" TextChanged="DirectoryInput_TextChanged" AutomationProperties.Name="工作目录" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                                    <Button Grid.Column="1" Content="浏览…" Click="BrowseDirectory_Click" Margin="0"/>
                                </Grid>
                                <WrapPanel><Button Content="使用 Profile 目录" Click="UseProfileDirectory_Click"/><Button Content="识别项目" Click="DetectProject_Click"/><Button Content="取消识别" Click="CancelDetect_Click"/></WrapPanel>
                                <TextBlock x:Name="DetectionStatus" Foreground="{DynamicResource Theme.SecondaryText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                <ItemsControl x:Name="DetectionResults" Margin="0,4,0,0"><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding DisplayText}" Tag="{Binding Path}" Click="ProjectCandidate_Click" HorizontalContentAlignment="Left" Margin="0,0,0,4"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Shell 与 Profile" FontSize="16" FontWeight="SemiBold" Margin="2,0,0,12"/>
                        <ItemsControl x:Name="ProfilesList"><ItemsControl.ItemTemplate><DataTemplate>
                            <Button AutomationProperties.Name="{Binding Name}" Tag="{Binding}" Click="ProfileLaunch_Click" HorizontalContentAlignment="Stretch" Margin="0,0,0,8" Padding="16,14">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource Theme.ActiveTabBackground}" Margin="0,0,14,0"><TextBlock x:Name="ProfileIcon" Text="{Binding Icon}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><TextBlock Text="{Binding WorkingDirectory}" Foreground="{DynamicResource Theme.SecondaryText}" FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/></StackPanel>
                                    <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource Theme.SecondaryText}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                </Grid>
                            </Button>
                            <DataTemplate.Triggers><DataTrigger Binding="{Binding Icon}" Value=""><Setter TargetName="ProfileIcon" Property="Text" Value="›_"/><Setter TargetName="ProfileIcon" Property="Foreground" Value="{DynamicResource Theme.AccentBrush}"/></DataTrigger></DataTemplate.Triggers>
                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        <Border Padding="20" CornerRadius="12" Margin="0,16,0,16" Background="{DynamicResource Theme.CardBackground}" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1">
                            <ContentControl x:Name="AgentPickerHost"/>
                        </Border>
                        <Border Padding="20" CornerRadius="12" Margin="0,16,0,16" Background="{DynamicResource Theme.CardBackground}" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <DockPanel><Button DockPanel.Dock="Right" Content="清空" Click="ClearRecents_Click" Margin="0"/><TextBlock Text="最近项目" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
                                <TextBlock x:Name="RecentsEmpty" Text="打开过的项目会显示在这里。" Foreground="{DynamicResource Theme.SecondaryText}" Margin="0,12,0,0"/>
                                <ItemsControl x:Name="RecentsList"><ItemsControl.ItemTemplate><DataTemplate>
                                    <DockPanel Margin="0,8,0,0"><Button DockPanel.Dock="Right" Content="&#xE8BB;" Style="{StaticResource IconButton}" Tag="{Binding Path}" Click="RemoveRecent_Click" ToolTip="移除最近项目" AutomationProperties.Name="移除最近项目"/><Button Content="{Binding DisplayName}" Tag="{Binding Path}" Click="RecentProject_Click" ToolTip="{Binding Path}" HorizontalContentAlignment="Left"/></DockPanel>
                                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="DataRootText" FontSize="11" Foreground="{DynamicResource Theme.SecondaryText}" TextWrapping="Wrap" Margin="2,4"/>
                    </StackPanel>
                </ScrollViewer>
                <Grid x:Name="SettingsPanel" Visibility="Collapsed" Margin="8,8,8,0">
<Grid.Resources>
    <Style x:Key="SettingsScrollViewer" TargetType="ScrollViewer">
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollViewer">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <controls:RoundedBorder CornerRadius="12">
                    <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" CanContentScroll="{TemplateBinding CanContentScroll}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Margin="{TemplateBinding Padding}"/>
                </controls:RoundedBorder>
                <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Orientation="Vertical" Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}" Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" Margin="4,0,0,0"/>
                <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Row="1" Orientation="Horizontal" Maximum="{TemplateBinding ScrollableWidth}" ViewportSize="{TemplateBinding ViewportWidth}" Value="{Binding HorizontalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" Margin="0,4,0,0"/>
            </Grid>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="184"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border CornerRadius="12" Background="{DynamicResource Theme.SidebarBackground}" Padding="8,12" Margin="0,0,16,0">
                    <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1"/>
                </Border>
                <ContentPresenter Grid.Column="1" x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" KeyboardNavigation.TabIndex="2"/>
            </Grid>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource Theme.SecondaryText}"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
            <Border x:Name="Frame" Padding="12,13" CornerRadius="8" Margin="0,3" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{TemplateBinding Foreground}" FontSize="16" VerticalAlignment="Center"/>
                    <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource Theme.HoverBackground}"/></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource Theme.HoverBackground}"/><Setter Property="Foreground" Value="{DynamicResource Theme.PrimaryText}"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Theme.AccentBrush}"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
</Grid.Resources>
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel Margin="4,0,0,20"><TextBlock x:Name="SettingsSectionTitle" Text="外观" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="让工作台更适合你。修改会即时预览，保存后生效。" Foreground="{DynamicResource Theme.SecondaryText}" Margin="0,6,0,0"/></StackPanel>
<TabControl x:Name="SettingsCategories" Grid.Row="1" TabStripPlacement="Left" SelectionChanged="SettingsCategory_Changed">
<TabItem Header="外观" Tag="&#xE790;"><ScrollViewer Style="{StaticResource SettingsScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"><StackPanel Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType={x:Type ScrollViewer}}}" MinWidth="600"><Border Padding="20" CornerRadius="12" Background="{DynamicResource Theme.CardBackground}" Margin="0,0,0,16"><StackPanel><TextBlock Text="字体与排版" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,18"/><StackPanel Orientation="Horizontal" Margin="0,0,0,12"><TextBlock Text="UI 字体" Width="180" VerticalAlignment="Center"/><TextBox x:Name="UiFontInput" Width="240" TextChanged="WorkbenchInput_Changed"/></StackPanel>
<StackPanel Orientation="Horizontal" Margin="0,0,0,12"><TextBlock Text="UI 字号（6—96）" Width="180" VerticalAlignment="Center"/><TextBox x:Name="FontSizeInput" Width="240" TextChanged="WorkbenchInput_Changed"/></StackPanel>
<StackPanel Orientation="Horizontal" Margin="0,0,0,12"><TextBlock Text="终端字体" Width="180" VerticalAlignment="Center"/><TextBox x:Name="TerminalFontInput" Width="240" TextChanged="WorkbenchInput_Changed"/></StackPanel>
<StackPanel Orientation="Horizontal" Margin="0,0,0,12"><TextBlock Text="终端字号（6—96）" Width="180" VerticalAlignment="Center"/><TextBox x:Name="TerminalFontSizeInput" Width="240" TextChanged="WorkbenchInput_Changed"/></StackPanel>
<StackPanel Orientation="Horizontal" Margin="0,0,0,12"><TextBlock Text="终端字重（100—1000）" Width="180" VerticalAlignment="Center"/><TextBox x:Name="TerminalWeightInput" Width="240" TextChanged="WorkbenchInput_Changed"/></StackPanel>
<StackPanel Orientation="Horizontal" Margin="0,0,0,12"><TextBlock Text="行高倍数（0.75—3）" Width="180" VerticalAlignment="Center"/><TextBox x:Name="TerminalLineHeightInput" Width="240" TextChanged="WorkbenchInput_Changed"/></StackPanel>
<StackPanel Orientation="Horizontal" Margin="0,0,0,12"><TextBlock Text="字距 DIP（-4—16）" Width="180" VerticalAlignment="Center"/><TextBox x:Name="TerminalSpacingInput" Width="240" TextChanged="WorkbenchInput_Changed"/></StackPanel>
<StackPanel Orientation="Horizontal" Margin="0,0,0,12"><TextBlock Text="强调色 #RRGGBB" Width="180" VerticalAlignment="Center"/><TextBox x:Name="AccentInput" Width="240" TextChanged="WorkbenchInput_Changed"/></StackPanel>
<CheckBox x:Name="LigaturesInput" Content="启用终端连字" Checked="WorkbenchInput_Changed" Unchecked="WorkbenchInput_Changed" Margin="0,0,0,8"/>
<CheckBox x:Name="TimestampsInput" Content="显示首次收到输出的时间戳" Checked="WorkbenchInput_Changed" Unchecked="WorkbenchInput_Changed" Margin="0,0,0,8"/>
<CheckBox x:Name="LineNumbersInput" Content="显示逻辑行号（不是命令编号）" Checked="WorkbenchInput_Changed" Unchecked="WorkbenchInput_Changed" Margin="0,0,0,8"/>
<CheckBox x:Name="DurationInput" Content="显示命令耗时（无可靠边界时为未知）" Checked="WorkbenchInput_Changed" Unchecked="WorkbenchInput_Changed" Margin="0,0,0,8"/>
<TextBlock x:Name="FontPreviewSource" Margin="0,4,0,4"/>
<controls:RoundedBorder CornerRadius="10" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" Margin="0,0,0,12"><rendering:DirectWriteTerminalControl x:Name="FontPreview" Height="140" IsHitTestVisible="False"/></controls:RoundedBorder>
</StackPanel></Border><Border Padding="20" CornerRadius="12" Background="{DynamicResource Theme.CardBackground}">                        <StackPanel x:Name="VisualSettingsControls" Margin="0,0,0,12">
                            <TextBlock Text="窗口与背景" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBlock x:Name="VisualCapabilityText" Foreground="{DynamicResource Theme.SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12"><TextBlock Text="主题" Width="180" VerticalAlignment="Center"/><ComboBox x:Name="ThemeInput" Width="180" SelectionChanged="VisualInput_Changed"><ComboBoxItem Content="跟随系统" Tag="System"/><ComboBoxItem Content="浅色" Tag="Light"/><ComboBoxItem Content="深色" Tag="Dark"/></ComboBox></StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12"><TextBlock Text="窗口材质" Width="180" VerticalAlignment="Center"/><ComboBox x:Name="MaterialInput" Width="180" SelectionChanged="VisualInput_Changed"><ComboBoxItem Content="自动（按能力）" Tag="Auto"/><ComboBoxItem Content="关闭" Tag="Off"/><ComboBoxItem Content="Mica" Tag="Mica"/><ComboBoxItem Content="Acrylic" Tag="Acrylic"/></ComboBox></StackPanel>
                            <CheckBox x:Name="DesktopBackgroundInput" Content="关闭应用背景并透出真实桌面后景" Checked="VisualInput_Changed" Unchecked="VisualInput_Changed" Margin="0,0,0,8"/>
                            <CheckBox x:Name="AuroraEnabledInput" Content="启用活动极光" Checked="VisualInput_Changed" Unchecked="VisualInput_Changed" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12"><TextBlock Text="极光预设" Width="180" VerticalAlignment="Center"/><ComboBox x:Name="AuroraPresetInput" Width="180" SelectionChanged="VisualInput_Changed"><ComboBoxItem Content="borealis · 青紫" Tag="borealis"/><ComboBoxItem Content="dawn · 晨曦" Tag="dawn"/><ComboBoxItem Content="ocean · 深海" Tag="ocean"/><ComboBoxItem Content="ember · 余烬" Tag="ember"/><ComboBoxItem Content="自定义" Tag="custom"/></ComboBox></StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12"><TextBlock Text="自定义色（3—6 个）" Width="180" VerticalAlignment="Center"/><TextBox x:Name="AuroraColorsInput" Width="360" TextChanged="VisualInput_Changed"/></StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8"><Button Content="导入背景图" Click="ImportBackground_Click"/><Button Content="清除背景图" Click="ClearBackground_Click"/><TextBlock x:Name="BackgroundPathText" VerticalAlignment="Center" Foreground="{DynamicResource Theme.SecondaryText}"/></StackPanel>
                            <TextBlock Text="亮度 / 饱和度 / 模糊只处理应用内静态背景图；系统 Mica/Acrylic 不提供这些任意参数。" Foreground="{DynamicResource Theme.SecondaryText}" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6"><TextBlock Text="背景遮罩" Width="180" VerticalAlignment="Center"/><Slider x:Name="BackgroundOverlayInput" Width="260" Minimum="0" Maximum="0.85" ValueChanged="VisualInput_Changed" AutoToolTipPlacement="TopLeft"/></StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6"><TextBlock Text="背景模糊（DIP）" Width="180" VerticalAlignment="Center"/><Slider x:Name="BackgroundBlurInput" Width="260" Minimum="0" Maximum="24" ValueChanged="VisualInput_Changed" AutoToolTipPlacement="TopLeft"/></StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6"><TextBlock Text="背景亮度" Width="180" VerticalAlignment="Center"/><Slider x:Name="BackgroundBrightnessInput" Width="260" Minimum="0.5" Maximum="1.5" ValueChanged="VisualInput_Changed" AutoToolTipPlacement="TopLeft"/></StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6"><TextBlock Text="背景饱和度" Width="180" VerticalAlignment="Center"/><Slider x:Name="BackgroundSaturationInput" Width="260" Minimum="0" Maximum="2" ValueChanged="VisualInput_Changed" AutoToolTipPlacement="TopLeft"/></StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12"><TextBlock Text="背景适配" Width="180" VerticalAlignment="Center"/><ComboBox x:Name="BackgroundFitInput" Width="180" SelectionChanged="VisualInput_Changed"><ComboBoxItem Content="完整适应" Tag="Uniform"/><ComboBoxItem Content="裁剪填满" Tag="UniformToFill"/><ComboBoxItem Content="拉伸填满" Tag="Fill"/><ComboBoxItem Content="原始大小" Tag="None"/></ComboBox></StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12"><TextBlock Text="背景位置" Width="180" VerticalAlignment="Center"/><ComboBox x:Name="BackgroundPositionInput" Width="180" SelectionChanged="VisualInput_Changed"><ComboBoxItem Content="左上" Tag="TopLeft"/><ComboBoxItem Content="顶部" Tag="Top"/><ComboBoxItem Content="右上" Tag="TopRight"/><ComboBoxItem Content="左侧" Tag="Left"/><ComboBoxItem Content="居中" Tag="Center"/><ComboBoxItem Content="右侧" Tag="Right"/><ComboBoxItem Content="左下" Tag="BottomLeft"/><ComboBoxItem Content="底部" Tag="Bottom"/><ComboBoxItem Content="右下" Tag="BottomRight"/></ComboBox></StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6"><TextBlock Text="终端背景不透明度" Width="180" VerticalAlignment="Center"/><Slider x:Name="TerminalOpacityInput" Width="260" Minimum="0.35" Maximum="1" ValueChanged="VisualInput_Changed" AutoToolTipPlacement="TopLeft"/></StackPanel>
                            <TextBlock x:Name="BackgroundStatusText" Foreground="{DynamicResource Theme.SecondaryText}" TextWrapping="Wrap"/>
                        </StackPanel></Border>

</StackPanel></ScrollViewer></TabItem>
<TabItem Header="快捷键" Tag="&#xE765;"><ScrollViewer Style="{StaticResource SettingsScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"><StackPanel Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType={x:Type ScrollViewer}}}" MinWidth="600"><Border Padding="20" CornerRadius="12" Background="{DynamicResource Theme.CardBackground}"><StackPanel><CheckBox x:Name="HotkeyEnabledInput" Content="启用全局命令面板热键" Checked="WorkbenchInput_Changed" Unchecked="WorkbenchInput_Changed" Margin="0,0,0,8"/>
<StackPanel Orientation="Horizontal" Margin="0,0,0,12"><TextBlock Text="命令面板热键" Width="180" VerticalAlignment="Center"/><TextBox x:Name="HotkeyInput" Width="240" TextChanged="WorkbenchInput_Changed"/></StackPanel>
<CheckBox x:Name="FocusHotkeyEnabledInput" Content="启用全局专注模式热键" Checked="WorkbenchInput_Changed" Unchecked="WorkbenchInput_Changed" Margin="0,0,0,8"/>
<StackPanel Orientation="Horizontal" Margin="0,0,0,12"><TextBlock Text="专注模式热键" Width="180" VerticalAlignment="Center"/><TextBox x:Name="FocusHotkeyInput" Width="240" TextChanged="WorkbenchInput_Changed"/></StackPanel>

<TextBlock x:Name="HotkeyStatusText" Margin="0,4,0,12"/>
<TextBlock Text="保存时替换注册；冲突保留旧组合。其余手势首版固定，输入框和 IME 保留正常编辑与候选导航。" Margin="0,0,0,12"/>
<ItemsControl x:Name="ShortcutList"><ItemsControl.ItemTemplate><DataTemplate><Border Padding="4,7" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="0,0,0,1"><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Shortcut}" Width="215" TextWrapping="Wrap"/><TextBlock Text="{Binding Title}"/></DockPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
<TextBlock Text="Ctrl+C 中断；Ctrl+Shift+C 只复制有效选区。清屏视图只清可见缓冲，清回滚只删主屏历史，均不向 Shell 发命令。cls / Clear-Host / clear 需用户在 Shell 中主动输入；Ctrl+L 继续交给 Shell。" Margin="0,12,0,0"/>
</StackPanel></Border></StackPanel></ScrollViewer></TabItem>
<TabItem Header="配置与 Profile" Tag="&#xE8B7;"><ScrollViewer Style="{StaticResource SettingsScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"><StackPanel Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType={x:Type ScrollViewer}}}" MinWidth="600"><Border Padding="20" CornerRadius="12" Background="{DynamicResource Theme.CardBackground}"><StackPanel><TextBlock Text="工作台" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10"/>
<StackPanel Orientation="Horizontal" Margin="0,0,0,12"><TextBlock Text="默认 Profile" Width="180" VerticalAlignment="Center"/><ComboBox x:Name="DefaultProfileInput" Width="240" SelectedValuePath="Id" SelectionChanged="WorkbenchInput_Changed"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
<StackPanel Orientation="Horizontal" Margin="0,0,0,12"><TextBlock Text="标签位置" Width="180" VerticalAlignment="Center"/><ComboBox x:Name="TabPositionInput" Width="160" SelectionChanged="WorkbenchInput_Changed"><ComboBoxItem Content="顶部" Tag="Top"/><ComboBoxItem Content="底部" Tag="Bottom"/><ComboBoxItem Content="左侧" Tag="Left"/></ComboBox></StackPanel>
<CheckBox x:Name="ConfirmCloseInput" Content="关闭运行中会话前确认" Checked="WorkbenchInput_Changed" Unchecked="WorkbenchInput_Changed" Margin="0,0,0,8"/>

<CheckBox x:Name="HistoryEnabledInput" Content="本次运行记录应用命令历史（重启后关闭）" Click="HistoryEnabled_Click" Margin="0,8"/>
<CheckBox x:Name="TranscriptionEnabledInput" Content="转录当前会话输出（每个新会话默认关闭）" Click="ToggleTranscript_Click" Margin="0,8"/>
<TextBlock x:Name="RecordingStatusText" TextWrapping="Wrap" Margin="0,0,0,8"/>
<WrapPanel Margin="0,0,0,12"><Button Content="查看 / 搜索应用历史" Click="ViewHistory_Click"/><Button Content="清除应用历史" Click="ClearHistory_Click"/><Button Content="停止并清除全部转录" Click="ClearTranscripts_Click"/></WrapPanel>
<TextBlock Text="草稿、已保存的旧记录偏好与布局恢复不会开启记录。Shell 自身历史策略保持原样。Ctrl+单击终端 URL / 路径可先查看完整目标；本地文件在资源管理器中定位。" TextWrapping="Wrap" Margin="0,0,0,16"/>
<TextBlock Text="Shell 通知（仅窗口失焦，无声音）" FontWeight="SemiBold"/>
<CheckBox x:Name="NotifyCompletedInput" Content="命令完成" Checked="WorkbenchInput_Changed" Unchecked="WorkbenchInput_Changed" Margin="0,6"/>
<CheckBox x:Name="NotifyLongTaskInput" Content="长任务结束" Checked="WorkbenchInput_Changed" Unchecked="WorkbenchInput_Changed" Margin="0,6"/>
<CheckBox x:Name="NotifyReadyInput" Content="可靠 Shell 提示符等待输入（不猜测程序内部等待）" Checked="WorkbenchInput_Changed" Unchecked="WorkbenchInput_Changed" Margin="0,6"/>
<StackPanel Orientation="Horizontal" Margin="0,6,0,16"><TextBlock Text="长任务门槛（秒）" Width="180" VerticalAlignment="Center"/><TextBox x:Name="LongTaskSecondsInput" Width="160" TextChanged="WorkbenchInput_Changed"/></StackPanel>
<ContentControl x:Name="ProfileEditorHost"/>
</StackPanel></Border></StackPanel></ScrollViewer></TabItem>
<TabItem Header="诊断与数据" Tag="&#xE9D9;"><ScrollViewer Style="{StaticResource SettingsScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"><StackPanel Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType={x:Type ScrollViewer}}}" MinWidth="600"><Border Padding="20" CornerRadius="12" Background="{DynamicResource Theme.CardBackground}"><StackPanel><TextBlock Text="诊断与数据" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10"/>
<TextBlock x:Name="SettingsDataRootText" Margin="0,0,0,12"/>
<WrapPanel><Button Content="预览诊断导出" Click="PreviewDiagnostics_Click"/><Button Content="显示 / 隐藏性能面板" Click="PerformancePanel_Click"/></WrapPanel>
<TextBlock Text="诊断仅含版本、能力、固定事件/错误码与性能计数。正文、完整命令、环境变量和转录目录不进入默认预览。确认之前不创建导出文件。" Margin="0,10"/>
<WrapPanel><Button Content="打开数据目录" Click="OpenDataDirectory_Click"/><Button Content="清理诊断日志 / 导出" Click="ClearDiagnostics_Click"/><Button Content="清空最近项目" Click="ClearRecents_Click"/></WrapPanel>
<TextBlock Text="日志：每文件 512 KiB，最多 3 份，7 天；导出：每份 1 MiB，最多 5 份，7 天。清理不操作配置、背景原图、Shell 历史或会话正文。" Margin="0,10"/>
</StackPanel></Border></StackPanel></ScrollViewer></TabItem>
</TabControl>
<Border Grid.Row="2" Margin="0,12,0,0" Padding="14,10" CornerRadius="12" Background="{DynamicResource Theme.SurfaceBackground}"><StackPanel><StackPanel.Resources><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="10,6"/><Setter Property="Margin" Value="0,3,6,3"/></Style></StackPanel.Resources><TextBlock x:Name="SettingsValidationText" Foreground="{DynamicResource Theme.ErrorBorder}" TextWrapping="Wrap" Margin="0,0,0,6"/>
<WrapPanel><Button x:Name="SaveDraftButton" Content="保存设置" Style="{StaticResource PrimaryButton}" Click="SaveDraftButton_Click"/><Button x:Name="CancelDraftButton" Content="取消设置预览" Click="CancelDraftButton_Click"/><Button Content="恢复当前分类默认值" Click="RestoreDefaults_Click"/><Button Content="重载正式配置" Click="ReloadFormal_Click"/><Button Content="重试草稿清理" Click="RetryCleanup_Click"/></WrapPanel>
<WrapPanel x:Name="ProfileSaveBar" Margin="0,6,0,0" Visibility="Collapsed"><Button x:Name="SaveProfilesButton" Content="保存 Profile" Style="{StaticResource PrimaryButton}" Click="SaveProfiles_Click"/><Button x:Name="CancelProfilesButton" Content="取消 Profile 草稿" Click="CancelProfiles_Click"/><TextBlock Text="本栏只提交 / 取消 Profile 目录。" VerticalAlignment="Center"/></WrapPanel>
</StackPanel></Border></Grid>
                <Grid x:Name="TerminalPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DockPanel Margin="4,0,4,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <TextBlock x:Name="TranscriptStatusText" VerticalAlignment="Center" FontSize="12" Margin="0,0,8,0"/>
                            <Button x:Name="ToggleTranscriptButton" Content="开始转录" Click="ToggleTranscript_Click" ToolTip="手动开启 / 停止当前会话文本转录"/>
                            <Button Content="&#xE74A;" Style="{StaticResource IconButton}" Click="ReturnBottom_Click" ToolTip="回到最新" AutomationProperties.Name="回到最新"/>
                            <Button Content="&#xE8C8;" Style="{StaticResource IconButton}" Click="DuplicateActive_Click" ToolTip="重复会话" AutomationProperties.Name="重复会话"/>
                            <Button Content="&#xE72C;" Style="{StaticResource IconButton}" Click="RestartActive_Click" ToolTip="重启会话" AutomationProperties.Name="重启会话"/>
                        </StackPanel>
                        <Grid VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock x:Name="CommandDurationText" Margin="0,0,8,0" Visibility="Collapsed"/><TextBlock x:Name="TerminalStatusText" Grid.Column="1" FontSize="12" Foreground="{DynamicResource Theme.SecondaryText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/></Grid>
                    </DockPanel>
                    <Border x:Name="SearchPanel" Grid.Row="1" Padding="8" CornerRadius="10" Background="{DynamicResource Theme.CardBackground}" Margin="0,0,0,8" Visibility="Collapsed">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="&#xE70E;" Style="{StaticResource IconButton}" Click="SearchPrevious_Click" ToolTip="上一个" AutomationProperties.Name="上一个匹配"/><Button Content="&#xE70D;" Style="{StaticResource IconButton}" Click="SearchNext_Click" ToolTip="下一个" AutomationProperties.Name="下一个匹配"/><Button Content="&#xE8BB;" Style="{StaticResource IconButton}" Click="CloseSearch_Click" ToolTip="关闭搜索" AutomationProperties.Name="关闭搜索"/><TextBlock x:Name="SearchStatusText" VerticalAlignment="Center" FontSize="12" Margin="8,0"/></StackPanel>
                            <TextBox x:Name="SearchInput" TextChanged="SearchInput_TextChanged" KeyDown="SearchInput_KeyDown" AutomationProperties.Name="搜索终端"/>
                        </DockPanel>
                    </Border>
                    <controls:RoundedBorder x:Name="TerminalFrame" Grid.Row="2" CornerRadius="12" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1">
                        <controls:RoundedBorder x:Name="TerminalCanvas" CornerRadius="11" BorderThickness="12"><Grid ClipToBounds="True"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Background="{Binding BorderBrush, ElementName=TerminalCanvas}" IsHitTestVisible="False"><ItemsControl x:Name="LineMetadataItems"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}" Height="{Binding Height}" TextWrapping="NoWrap" Foreground="{DynamicResource Theme.SecondaryText}" Margin="0,0,8,0" VerticalAlignment="Top"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Border>
                            <rendering:DirectWriteTerminalControl x:Name="TerminalView" Grid.Column="1"/>
                        </Grid></controls:RoundedBorder>
                    </controls:RoundedBorder>
                    <Border x:Name="PlaceholderPanel" Grid.Row="2" Padding="28" CornerRadius="12" Background="{DynamicResource Theme.CardBackground}" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="480"><TextBlock x:Name="PlaceholderTitle" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="PlaceholderDetails" Foreground="{DynamicResource Theme.SecondaryText}" TextWrapping="Wrap" Margin="0,12,0,20"/><Button Content="启动此会话" Style="{StaticResource PrimaryButton}" Click="StartPlaceholder_Click" HorizontalAlignment="Left"/></StackPanel>
                    </Border>
                    <TextBlock x:Name="TerminalShortcutHint" Grid.Row="3" Margin="4,8,0,0" FontSize="11" Foreground="{DynamicResource Theme.SecondaryText}" Text="Ctrl+Shift+C / V  复制 / 粘贴     Ctrl+F  搜索     Ctrl+Tab  切换标签"/>
                </Grid>
            </Grid>

            <Border x:Name="CommandPalette" Grid.Row="0" Grid.RowSpan="4" Grid.ColumnSpan="3" Visibility="Collapsed" Background="{DynamicResource Theme.OverlayBackground}" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="12" Width="560" MaxHeight="430" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,58,0,0" Panel.ZIndex="10">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBox x:Name="CommandInput" TextChanged="CommandInput_TextChanged" KeyDown="CommandInput_KeyDown" FontSize="16" Padding="12,10" AutomationProperties.Name="搜索命令"/>
                    <ListBox x:Name="CommandResults" Grid.Row="1" Margin="0,8,0,0" BorderThickness="0" Background="Transparent" MaxHeight="300" MouseDoubleClick="CommandResults_MouseDoubleClick">
                        <ListBox.ItemTemplate><DataTemplate><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Shortcut}" Foreground="{DynamicResource Theme.SecondaryText}" FontSize="11" VerticalAlignment="Center" Margin="16,0,0,0"/><StackPanel><TextBlock Text="{Binding Title}"/><TextBlock Text="{Binding Category}" FontSize="11" Foreground="{DynamicResource Theme.SecondaryText}" Margin="0,3,0,0"/></StackPanel></DockPanel></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Grid.Row="2" Text="↑ ↓  选择     Enter  执行     Esc  关闭" FontSize="11" Foreground="{DynamicResource Theme.SecondaryText}" Margin="8,12,0,2"/>
                </Grid>
            </Border>
            <Border x:Name="PerformancePanel" Grid.Row="4" Grid.ColumnSpan="3" Visibility="Collapsed" CornerRadius="10" Background="{DynamicResource Theme.CardBackground}" Padding="12" Margin="10,8,10,0" MaxHeight="180">
                <DockPanel><Button DockPanel.Dock="Right" Content="关闭指标" Click="PerformancePanel_Click" VerticalAlignment="Top"/><ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock x:Name="PerformanceText" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/></ScrollViewer></DockPanel>
            </Border>
            <Border x:Name="DiagnosticPreviewPanel" Grid.Row="1" Grid.RowSpan="3" Grid.ColumnSpan="3" Visibility="Collapsed" Panel.ZIndex="20" CornerRadius="14" Margin="24,12" Padding="20" Background="{DynamicResource Theme.OverlayBackground}" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,16"><TextBlock Text="诊断预览" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="你可以编辑下方内容，确认后将保存最终文本。" Foreground="{DynamicResource Theme.SecondaryText}" Margin="0,6,0,0"/></StackPanel>
                    <TextBox x:Name="DiagnosticPreviewInput" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12" TextChanged="DiagnosticPreview_TextChanged"/>
                    <StackPanel Grid.Row="2" Margin="0,12,0,0"><TextBlock x:Name="DiagnosticSizeText" Margin="0,0,0,8"/><WrapPanel><Button x:Name="ConfirmDiagnosticButton" Content="确认导出" Style="{StaticResource PrimaryButton}" Click="ConfirmDiagnostic_Click"/><Button Content="取消" Click="CancelDiagnostic_Click"/></WrapPanel></StackPanel>
                </Grid>
            </Border>
            <StatusBar Grid.Row="5" Grid.ColumnSpan="3" MinHeight="26" Margin="12,2">
                <StatusBarItem><TextBlock x:Name="ModeText" Foreground="{DynamicResource Theme.SecondaryText}" Margin="0,0,12,0"/></StatusBarItem>
                <StatusBarItem><TextBlock x:Name="StatusText" Foreground="{DynamicResource Theme.SecondaryText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/></StatusBarItem>
            </StatusBar>
        </Grid>
    </Grid>
    </controls:RoundedBorder>
</Window>
