<Window x:Class="ArkTerminal.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:rendering="clr-namespace:ArkTerminal.Rendering"
        xmlns:controls="clr-namespace:ArkTerminal.Controls"
        Title="ArkTerminal · 新建" Width="1100" Height="760" MinWidth="720" MinHeight="520"
        Closing="Window_Closing" SourceInitialized="Window_SourceInitialized" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid x:Name="RootGrid" Margin="12">
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="LeftTabColumn" Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <Grid x:Name="TabHost" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel x:Name="TabNavigationButtons" Orientation="Horizontal">
                <Button Content="‹" Click="PreviousTab_Click" ToolTip="上一个标签"/>
                <Button Content="›" Click="NextTab_Click" ToolTip="下一个标签"/>
            </StackPanel>
            <ScrollViewer x:Name="TabScrollViewer" Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <controls:TerminalTabStrip x:Name="TabStrip" OrientationEx="Horizontal">
                    <controls:TerminalTabStrip.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </controls:TerminalTabStrip.ItemsPanel>
                    <controls:TerminalTabStrip.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="TabBorder" Padding="8,6" Margin="2" BorderBrush="#BBBBBB" BorderThickness="1" CornerRadius="3"
                                    MouseLeftButtonDown="Tab_MouseLeftButtonDown"
                                    ToolTip="{Binding ToolTipText}">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="重命名 / 清除固定名称" Click="RenameTab_Click"/>
                                        <MenuItem Header="重复标签" Click="DuplicateTab_Click"/>
                                        <MenuItem Header="重启会话" Click="RestartTab_Click"/>
                                        <Separator/>
                                        <MenuItem Header="关闭标签" Click="CloseTab_Click"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="×" Padding="5,0" Margin="4,0,0,0" Click="CloseTab_Click" ToolTip="关闭标签"/>
                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsActive}" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="#DDEBFF"/></DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </controls:TerminalTabStrip.ItemTemplate>
                </controls:TerminalTabStrip>
            </ScrollViewer>
            <Button x:Name="NewTabButton" Grid.Column="2" Content="＋ 新建" Click="NewPage_Click"/>
            <TextBlock Grid.Column="3" x:Name="TabCountText" VerticalAlignment="Center" Margin="4,0"/>
        </Grid>
        <GridSplitter x:Name="LeftTabSplitter" Grid.Row="2" Grid.Column="1" Width="5" Visibility="Collapsed"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Columns"
                      ResizeBehavior="PreviousAndNext" Background="#EEEEEE" Cursor="SizeWE"/>

        <StackPanel x:Name="NavigationPanel" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="新建页" Click="NewPage_Click"/>
            <Button Content="命令面板  Ctrl+Shift+Space" Click="ShowCommandPalette_Click"/>
            <Button Content="设置" Click="Settings_Click"/>
            <Button Content="专注模式" Click="FocusMode_Click"/>
            <TextBlock x:Name="ModeText" VerticalAlignment="Center" Foreground="#555555"/>
        </StackPanel>

        <Grid Grid.Row="2" Grid.Column="2">
            <ScrollViewer x:Name="NewPage" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="12">
                    <TextBlock Text="新建" FontSize="30" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Foreground="#555555" Margin="0,0,0,18" Text="选择 Shell 后才会创建独立会话；启动和恢复占位不会自动运行进程。"/>
                    <Border x:Name="ErrorPanel" Padding="14" Margin="0,0,0,12" Background="#FFF3F3" BorderBrush="#CC4444" BorderThickness="1">
                        <StackPanel><TextBlock Text="需要处理的问题" FontWeight="SemiBold"/><TextBlock x:Name="ErrorText" TextWrapping="Wrap" Margin="0,6"/><Button Content="备份后恢复无效文档默认值" Click="ResetButton_Click" HorizontalAlignment="Left"/></StackPanel>
                    </Border>
                    <Border x:Name="RecoveryPanel" Padding="14" Margin="0,0,0,12" Background="#F5F8FF" BorderBrush="#99BBEE" BorderThickness="1">
                        <StackPanel><TextBlock Text="检测到异常退出" FontWeight="SemiBold"/><TextBlock Text="可恢复待确认草稿和未启动标签布局；不会重建进程或执行恢复命令。" Margin="0,6"/><StackPanel Orientation="Horizontal"><Button Content="恢复" Click="RecoverButton_Click"/><Button Content="丢弃恢复数据" Click="DiscardRecoveryButton_Click"/></StackPanel></StackPanel>
                    </Border>
                    <Border Padding="14" Margin="0,0,0,12" BorderBrush="#DDDDDD" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="项目目录" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8"><TextBox x:Name="DirectoryInput" Width="430" VerticalContentAlignment="Center"/><Button Content="选择目录" Click="BrowseDirectory_Click"/><Button Content="识别项目" Click="DetectProject_Click"/><Button Content="取消" Click="CancelDetect_Click"/></StackPanel>
                            <TextBlock x:Name="DetectionStatus" Foreground="#555555" TextWrapping="Wrap"/>
                            <ItemsControl x:Name="DetectionResults" Margin="0,6"><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding DisplayText}" Tag="{Binding Path}" Click="ProjectCandidate_Click" HorizontalContentAlignment="Left" Margin="0,0,0,4"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Padding="14" Margin="0,0,0,12" BorderBrush="#DDDDDD" BorderThickness="1">
                        <StackPanel><TextBlock Text="Shell / Profile" FontWeight="SemiBold" Margin="0,0,0,8"/><ItemsControl x:Name="ProfilesList"><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Name}" Tag="{Binding}" Click="ProfileLaunch_Click" HorizontalContentAlignment="Left" Margin="0,0,0,6"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
                    </Border>
                    <Border Padding="14" Margin="0,0,0,12" BorderBrush="#DDDDDD" BorderThickness="1">
                        <StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="最近项目" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Content="清空" Click="ClearRecents_Click"/></StackPanel><TextBlock x:Name="RecentsEmpty" Text="暂无最近项目" Foreground="#666666" Margin="0,6"/><ItemsControl x:Name="RecentsList"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Margin="0,3"><Button Content="{Binding DisplayName}" Tag="{Binding Path}" Click="RecentProject_Click" ToolTip="{Binding Path}"/><Button Content="删除" Tag="{Binding Path}" Click="RemoveRecent_Click"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
                    </Border>
                    <Border Padding="14" Margin="0,0,0,12" BorderBrush="#DDDDDD" BorderThickness="1"><StackPanel><TextBlock Text="Agent" FontWeight="SemiBold"/><TextBlock Text="当前没有可用 Agent。检测与启动适配由阶段 8 提供，本阶段不会自动探测或启动第三方程序。" Foreground="#666666" Margin="0,6"/></StackPanel></Border>
                    <TextBlock x:Name="DataRootText" Foreground="#666666" TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="12">
                    <TextBlock Text="设置" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <TextBlock Text="修改进入临时预览；保存才写入正式设置，取消撤回预览。" Foreground="#555555" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8"><TextBlock Text="UI 字号" Width="150"/><TextBox x:Name="FontSizeInput" Width="100" TextChanged="FontSizeInput_TextChanged"/></StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8"><TextBlock Text="标签位置" Width="150"/><ComboBox x:Name="TabPositionInput" Width="160" SelectionChanged="WorkbenchInput_Changed"><ComboBoxItem Content="顶部" Tag="Top"/><ComboBoxItem Content="底部" Tag="Bottom"/><ComboBoxItem Content="左侧" Tag="Left"/></ComboBox></StackPanel>
                    <CheckBox x:Name="ConfirmCloseInput" Content="关闭运行中会话前确认" Checked="WorkbenchInput_Changed" Unchecked="WorkbenchInput_Changed" Margin="0,0,0,8"/>
                    <CheckBox x:Name="HotkeyEnabledInput" Content="启用全局命令面板热键" Checked="WorkbenchInput_Changed" Unchecked="WorkbenchInput_Changed" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12"><TextBlock Text="热键手势" Width="150"/><TextBox x:Name="HotkeyInput" Width="200" TextChanged="WorkbenchInput_Changed"/></StackPanel>
                    <StackPanel Orientation="Horizontal"><Button x:Name="EditDraftButton" Content="编辑草稿" Click="EditDraftButton_Click"/><Button x:Name="SaveDraftButton" Content="保存正式设置" Click="SaveDraftButton_Click"/><Button x:Name="CancelDraftButton" Content="取消预览" Click="CancelDraftButton_Click"/></StackPanel>
                    <TextBlock x:Name="HotkeyStatusText" Foreground="#555555" TextWrapping="Wrap" Margin="0,12"/>
                </StackPanel>
            </ScrollViewer>

            <Grid x:Name="TerminalPanel" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6"><Button Content="回到最新" Click="ReturnBottom_Click"/><Button Content="重复" Click="DuplicateActive_Click"/><Button Content="重启" Click="RestartActive_Click"/><TextBlock x:Name="TerminalStatusText" VerticalAlignment="Center" TextWrapping="Wrap"/></StackPanel>
                <StackPanel x:Name="SearchPanel" Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6" Visibility="Collapsed"><TextBox x:Name="SearchInput" Width="260" TextChanged="SearchInput_TextChanged" KeyDown="SearchInput_KeyDown"/><Button Content="上一个" Click="SearchPrevious_Click"/><Button Content="下一个" Click="SearchNext_Click"/><Button Content="关闭" Click="CloseSearch_Click"/><TextBlock x:Name="SearchStatusText" VerticalAlignment="Center"/></StackPanel>
                <rendering:DirectWriteTerminalControl x:Name="TerminalView" Grid.Row="2"/>
                <Border x:Name="PlaceholderPanel" Grid.Row="2" Padding="24" BorderBrush="#CCCCCC" BorderThickness="1"><StackPanel><TextBlock x:Name="PlaceholderTitle" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="PlaceholderDetails" TextWrapping="Wrap" Margin="0,10"/><Button Content="明确启动此会话" Click="StartPlaceholder_Click" HorizontalAlignment="Left"/></StackPanel></Border>
                <TextBlock Grid.Row="3" Margin="0,6,0,0" Foreground="#555555" Text="Ctrl+Shift+C/V 复制/粘贴 · Ctrl+F 搜索 · Ctrl+Tab 切换 · Ctrl+Shift+F11 专注"/>
            </Grid>
        </Grid>

        <Border x:Name="CommandPalette" Grid.Row="0" Grid.RowSpan="4" Grid.Column="0" Grid.ColumnSpan="3" Visibility="Collapsed" Background="#F8F8F8" BorderBrush="#777777" BorderThickness="1" CornerRadius="5" Padding="12" Width="560" MaxHeight="480" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,70,0,0" Panel.ZIndex="10">
            <StackPanel><TextBox x:Name="CommandInput" TextChanged="CommandInput_TextChanged" KeyDown="CommandInput_KeyDown" FontSize="18" Padding="8"/><ListBox x:Name="CommandResults" Margin="0,8,0,0" DisplayMemberPath="Title" MouseDoubleClick="CommandResults_MouseDoubleClick"/><TextBlock Text="Enter 执行 · Esc 关闭；未实现的 Agent、Skill 与工作区不提供假命令" Foreground="#666666" Margin="0,6,0,0"/></StackPanel>
        </Border>
        <StatusBar Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"><StatusBarItem><TextBlock x:Name="StatusText" TextWrapping="Wrap"/></StatusBarItem></StatusBar>
    </Grid>
</Window>
