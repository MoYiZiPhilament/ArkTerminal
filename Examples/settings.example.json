{
  "schemaVersion": 1,
  "appearance": {
    "uiFontFamily": "Segoe UI",
    "uiFontSize": 14,
    "terminalFontFamily": "Cascadia Mono",
    "terminalFontSize": 14,
    "terminalFontWeight": 400,
    "terminalLineHeight": 1.15,
    "terminalCharacterSpacing": 0,
    "terminalLigatures": false,
    "showTimestamps": false,
    "showLogicalLineNumbers": false,
    "showCommandDuration": false,
    "accentColor": "#4688F1",
    "visual": {
      "theme": "System",
      "material": "Auto",
      "desktopBackgroundEnabled": false,
      "auroraEnabled": true,
      "auroraPresetId": "borealis",
      "auroraCustomColors": ["#7C3AED", "#2563EB", "#10B981"],
      "backgroundImagePath": "",
      "backgroundOverlayOpacity": 0.25,
      "backgroundBlurRadius": 0,
      "backgroundBrightness": 1,
      "backgroundSaturation": 1,
      "backgroundFit": "UniformToFill",
      "backgroundPosition": "Center",
      "terminalBackgroundOpacity": 0.9
    }
  },
  "defaultProfileId": "cmd",
  "regional": {
    "language": "en-US",
    "timeZoneId": "China Standard Time"
  },
  "history": {
    "enabled": false,
    "maxEntries": 1000,
    "maxSizeBytes": 1048576,
    "retentionDays": 30
  },
  "transcription": {
    "enabled": false,
    "maxFileSizeBytes": 10485760,
    "maxTotalSizeBytes": 104857600,
    "retentionDays": 7
  },
  "shellNotifications": {
    "commandCompletedEnabled": false,
    "longTaskEnabled": true,
    "readyForInputEnabled": false,
    "longTaskSeconds": 10
  },
  "workbench": {
    "tabPosition": "Top",
    "confirmCloseRunning": true,
    "commandPaletteHotkeyEnabled": true,
    "commandPaletteHotkey": "Ctrl+Shift+Space",
    "focusModeHotkeyEnabled": true,
    "focusModeHotkey": "Ctrl+Shift+F11"
  }
}
