{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkterminal.local/schemas/agent-adapter-v1.json",
  "title": "ArkTerminal declarative Agent adapter v1",
  "description": "UTF-8 <= 65536 bytes, maximum JSON depth 8. Files require explicit hash-bound approval. Runtime also rejects duplicate keys and IDs, credentials, unknown variables and recursive/embedded templates.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "displayName", "executableCandidates", "launchTemplate", "variables", "fields", "capabilities", "statusSignals", "evidence"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\u0000-\\u001f\\u007f]+$" },
    "executableCandidates": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string", "maxLength": 128, "pattern": "^[^/\\\\:\\u0000-\\u001f]+\\.(exe|cmd|ps1)$" } },
    "overridePath": { "type": ["string", "null"], "maxLength": 2048, "description": "An absolute file path. The user override in Config/agent-adapters.json takes priority." },
    "versionProbe": {
      "type": ["object", "null"], "additionalProperties": false,
      "properties": {
        "arguments": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/$defs/literal" } },
        "timeoutMilliseconds": { "type": "integer", "minimum": 100, "maximum": 3000, "default": 3000 },
        "maxOutputBytes": { "type": "integer", "minimum": 1024, "maximum": 65536, "default": 65536 }
      }
    },
    "launchTemplate": { "$ref": "#/$defs/cwdTemplate" },
    "variables": { "type": "array", "maxItems": 2, "uniqueItems": true, "items": { "enum": ["model", "workingDirectory"] } },
    "fields": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "model": { "$ref": "#/$defs/modelTemplate" },
        "permissionModes": { "type": "object", "maxProperties": 16, "propertyNames": { "$ref": "#/$defs/id" }, "additionalProperties": { "$ref": "#/$defs/cwdTemplate" } },
        "arguments": {
          "type": "array", "maxItems": 16,
          "items": {
            "type": "object", "additionalProperties": false,
            "properties": {
              "flag": { "type": "string", "pattern": "^--?[A-Za-z][A-Za-z0-9-]{0,63}$", "description": "Unique; credential switches are forbidden." },
              "takesValue": { "type": "boolean", "default": false },
              "repeatable": { "type": "boolean", "default": false },
              "allowedValues": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/literal" } }
            },
            "required": ["flag"]
          }
        }
      }
    },
    "capabilities": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "interactiveInput": { "type": "boolean", "default": false },
        "resume": { "type": "boolean", "default": false },
        "programmaticHandoff": { "const": false }
      }
    },
    "statusSignals": { "type": "array", "maxItems": 1, "items": { "const": "process" } },
    "evidence": { "type": "string", "maxLength": 2048 },
    "unsupportedReason": { "type": ["string", "null"], "maxLength": 2048 }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
    "literal": { "type": "string", "maxLength": 2048, "pattern": "^(?!.*(?:\\{\\{|\\}\\}))[^\\u0000-\\u001f\\u007f]*$" },
    "cwdTemplate": {
      "type": "array", "maxItems": 32,
      "items": { "anyOf": [{ "$ref": "#/$defs/literal" }, { "const": "{{workingDirectory}}" }] }
    },
    "modelTemplate": {
      "type": "array", "maxItems": 32,
      "items": { "anyOf": [{ "$ref": "#/$defs/literal" }, { "enum": ["{{model}}", "{{workingDirectory}}"] }] }
    }
  }
}
